[Unit]
Description=Toss AI Agent PAPER trading cycle
After=network-online.target
Wants=network-online.target

[Service]
# 한 번 실행하고 종료하는 작업입니다. 반복 주기는 .timer가 담당합니다.
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/toss-api/apps/toss-ai-agent
EnvironmentFile=/home/ubuntu/toss-api/apps/toss-ai-agent/.env
ExecStart=/home/ubuntu/.nvm/versions/node/v24.18.0/bin/node src/paper/paper-runner.js
# 생성 파일은 소유자만 읽을 수 있고, data 이외의 경로에는 쓰지 못하게 제한합니다.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/toss-api/apps/toss-ai-agent/data

[Install]
WantedBy=multi-user.target
