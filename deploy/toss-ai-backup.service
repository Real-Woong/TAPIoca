[Unit]
Description=Toss AI Agent data snapshot (되살릴 수 없는 파일만)

[Service]
# 한 번 담고 종료합니다. 반복은 backup.timer가 담당합니다.
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/toss-api/apps/toss-ai-agent
ExecStart=/bin/bash /home/ubuntu/toss-api/apps/toss-ai-agent/scripts/snapshot-data.sh
# 백업 파일은 소유자만 읽을 수 있게 둡니다. 실주문 원장이 들어 있습니다.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# **읽기는 data/, 쓰기는 백업 폴더만.** 스냅샷이 앱 폴더를 건드릴 이유가 없고,
# 실수로라도 data/ 를 못 쓰게 막아 두면 백업이 원본을 망칠 수 없습니다.
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/toss-backups

[Install]
WantedBy=multi-user.target
