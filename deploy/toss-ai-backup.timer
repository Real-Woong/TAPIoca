[Unit]
Description=Snapshot Toss AI Agent data daily

[Timer]
# 뉴욕 현지 16:30. 정규장(~16:00)이 끝나고 일일 리포트(16:10)까지 지난 뒤라
# 그날 사이클이 전부 담깁니다. 평일만 도는 리포트와 달리 **매일** 담습니다 —
# 주말에 사고가 나도 금요일치가 남아 있어야 하기 때문입니다.
OnCalendar=*-*-* 16:30:00 America/New_York
# 서버가 꺼져 시각을 놓쳤으면 부팅 후 한 번 따라잡습니다.
Persistent=true
RandomizedDelaySec=60s
Unit=toss-ai-backup.service

[Install]
WantedBy=timers.target
