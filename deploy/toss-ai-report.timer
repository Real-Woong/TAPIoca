[Unit]
Description=Send Toss AI Agent report after US market close

[Timer]
# 뉴욕 현지 평일 16:10에 실행합니다. 한국에서는 다음 날 새벽이며 서머타임도 자동 반영됩니다.
OnCalendar=Mon..Fri *-*-* 16:10:00 America/New_York
# 서버가 꺼져 실행 시각을 놓쳤다면 재부팅 후 누락된 작업을 한 번 실행합니다.
Persistent=true
RandomizedDelaySec=30s
AccuracySec=1s
Unit=toss-ai-report.service

[Install]
WantedBy=timers.target
